{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "astro-dev",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "astro",
        "dev",
        "--port",
        "4321"
      ],
      "port": 4321
    },
    {
      "name": "static-dist",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "4322",
        "--bind",
        "127.0.0.1",
        "--directory",
        "dist"
      ],
      "port": 4322
    }
  ]
}
