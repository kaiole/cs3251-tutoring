# Copy to .env for local development. Never commit real values.
# Local values come from `npx supabase status -o env`.

# Canonical site origin (used for auth email links and notification links). No trailing slash.
SITE_URL=http://localhost:4321

# Supabase project URL and publishable (anon) key. Server-side only in this app: the browser never
# talks to Supabase directly. The publishable key is NOT authorization; RLS + RPC checks are.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=

# Notification worker only (netlify/functions). Never exposed to Astro routes or client bundles.
SUPABASE_SECRET_KEY=
RESEND_API_KEY=
NOTIFY_FROM="CS3251 Tutoring <notify@example.test>"
# "log" (default; prints job ids only, sends nothing) or "resend".
NOTIFY_TRANSPORT=log
