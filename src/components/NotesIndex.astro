---
/**
 * Home page list of notes: one section per folder under src/content/docs/notes/, labelled with the
 * folder name exactly as the sidebar's autogenerated groups are. Nothing to update by hand.
 */
import { getCollection } from 'astro:content';

const notes = await getCollection('docs', (entry) => entry.id.startsWith('notes/') && !entry.data.draft);

const groups = new Map<string, typeof notes>();
for (const note of notes) {
  // filePath keeps the folder's original spelling (the id is slugified), matching the sidebar label.
  const folder = note.filePath?.split('/').at(-2) ?? note.id.split('/')[1] ?? 'notes';
  groups.set(folder, [...(groups.get(folder) ?? []), note]);
}

const byOrderThenTitle = (a: (typeof notes)[number], b: (typeof notes)[number]) =>
  (a.data.sidebar?.order ?? Infinity) - (b.data.sidebar?.order ?? Infinity) || a.data.title.localeCompare(b.data.title);

const sections = [...groups.entries()]
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([folder, entries]) => ({ folder, entries: entries.sort(byOrderThenTitle) }));
---

{
  sections.map(({ folder, entries }) => (
    <>
      <h2>{folder}</h2>
      <ul>
        {entries.map((note) => (
          <li>
            <a href={`/${note.id}/`}>{note.data.title}</a>
          </li>
        ))}
      </ul>
    </>
  ))
}
